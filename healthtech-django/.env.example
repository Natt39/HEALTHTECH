# Copia este archivo a ".env" y completa los valores. NUNCA subas ".env" a Git.

# --- Django ---
# Genera una clave: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Base de datos (opcional; sin esto usa SQLite local) ---
# DATABASE_URL=postgresql://usuario:clave@host:5432/healthtech

# --- CORS / CSRF: orígenes del frontend (separados por coma, sin "/" final) ---
# En producción agrega el sitio del frontend, p. ej. https://natt39.github.io (solo el origen, sin ruta)
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://natt39.github.io
# En Render el host propio (https://<tu-app>.onrender.com) se agrega solo; aquí solo si usas otro dominio
CSRF_TRUSTED_ORIGINS=

# --- JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Rate limiting (formato: N/min | N/hour | N/day) ---
THROTTLE_LOGIN=5/min
THROTTLE_REGISTRO=10/hour
THROTTLE_IA=10/hour
# Proxies delante de Django: 0 en local; en Render se toma 1 automáticamente
NUM_PROXIES=0

# --- IA (Gemini) para analizar la hoja de dosificación ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
RECETA_MAX_MB=5

# --- Solo Render (opcional): crea el superusuario durante el build para entrar a /admin ---
# DJANGO_SUPERUSER_USERNAME=admin@correo.cl
# DJANGO_SUPERUSER_EMAIL=admin@correo.cl
# DJANGO_SUPERUSER_PASSWORD=
